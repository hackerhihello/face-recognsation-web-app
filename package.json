{
  "name": "face-attendance-platform",
  "private": true,
  "workspaces": [
    "apps/client-admin",
    "apps/super-admin",
    "backend"
  ],
  "scripts": {
    "dev:client": "npm run dev -w apps/client-admin",
    "dev:super": "npm run dev -w apps/super-admin",
    "dev:backend": "npm run dev -w backend",
    "build:client": "npm run build -w apps/client-admin",
    "build:super": "npm run build -w apps/super-admin",
    "build": "npm run build:client && npm run build:super",
    "start:client": "npm run start -w apps/client-admin",
    "start:super": "npm run start -w apps/super-admin",
    "lint": "npm run lint -w apps/client-admin",
    "typecheck:backend": "npm run typecheck -w backend",
    "test:backend": "npm run test -w backend"
  }
}
