# Client Admin Dashboard Environment Configuration

# Server Port (Separate from Super Admin running on 3000)
PORT=3001

# Target Railway Face Recognition API
FACE_API_BASE_URL=https://face-engine.up.railway.app
FACE_API_SECRET_KEY=<set-in-server-env-only>

# Convex Cloud Deployment
NEXT_PUBLIC_CONVEX_URL=https://fancy-puma-123.convex.cloud
CONVEX_DEPLOYMENT=prod:fancy-puma-123

# Cloudflare R2 Storage (Managed server-side)
CLOUDFLARE_R2_ACCOUNT_ID=d98a21f872391024
CLOUDFLARE_R2_BUCKET=face-biometrics-vault
