# Client Admin app — copy to .env.local. Never commit real values.

# Data source for the UI: "sample" (labelled preview data) or "convex".
# "convex" is not wired yet; see docs/FRONTEND_PHASE1.md.
NEXT_PUBLIC_DATA_SOURCE=sample

# Local preview identity (no real sign-in yet). Defaults to on in `next dev`
# only. Set to "false" to test the signed-out flow.
# ENABLE_PREVIEW_SESSION=true

# Convex HTTP actions URL used by the server-side /api/face/* proxy routes.
# The Face API key (X-API-Key) is stored in Convex, never in this app.
CONVEX_SITE_URL=https://<your-deployment>.convex.site
